{
  "name": "Stock Manager TT",
  "short_name": "StockMgr",
  "start_url": ".",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#007bff",
  "description": "A simple stock management tool for small businesses in Trinidad & Tobago.",
  "id": ".",
  "launch_handler": "system",
  "orientation": "any",
  "handle_links": "auto",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx",
          ".xls"
        ]
      }
    }
  ]
}